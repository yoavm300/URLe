{
  "name": "redirect",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:python", "type:service"],
  "implicitDependencies": ["shared"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "ruff check shared/ services/redirect/",
          "ruff format --check shared/ services/redirect/"
        ],
        "cwd": "{workspaceRoot}",
        "parallel": false
      }
    },
    "smoke-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "python -c \"from app import create_app; c = create_app().test_client(); r = c.get('/healthz'); assert r.status_code == 200, r.status_code; print('PASS: /healthz ->', r.status_code)\"",
        "cwd": "{workspaceRoot}",
        "env": {
          "SECRET_KEY": "ci-smoke-test-key",
          "PYTHONPATH": ".:services/redirect"
        }
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f services/redirect/Dockerfile -t urle-redirect:ci .",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
